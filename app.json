{
  "expo": {
    "name": "Construction Corner",
    "slug": "construction-corner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E874B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1E874B"
      },
      "package": "com.constructioncorner.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Construction Corner uses your location to auto-fill your current city, state and pincode on your profile."
        }
      ],
      "expo-speech-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Construction Corner needs access to your photos to attach images in chat.",
          "cameraPermission": "Construction Corner needs access to your camera to take a photo to share in chat."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx6144m -XX:MaxMetaspaceSize=2048m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f3ff9454-1374-4b67-b8e1-2be5b8ed1106"
      }
    },
    "ios": {}
  }
}
